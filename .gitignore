# LGBM Copilot — .gitignore (merged)

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Data (too large for GitHub)
data/raw/
data/processed/
data/labeled/
data/exam/
*.csv
*.parquet
*.pkl
*.pth
*.npy
*.gguf
*.db
*.sqlite

# Models (large binary)
models/
charts/
*.bin
*.onnx
*.wasm

# Logs (rotate, don't store)
logs/*.log
*.log

# Lock files
lock/*.pid
lock/*.lock

# Rust build artifacts
tools/yantrikdb_py/target/
*.so
*.d

# Temp
*.tmp
*.bak
.gh_token

# IDE
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# DEB csomagok
*.deb

# GraphRAG output
graphrag_data/output/
graphrag_data/cache/
graphrag_data/lancedb/

# Secure
secure/
