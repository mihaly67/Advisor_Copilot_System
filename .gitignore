# LGBM Copilot — .gitignore

# === NEM felküldendő (túl nagy / generált) ===
models/
charts/
__pycache__/
*.pyc
*.pyo

# Nyers adat CSV-k (GB-ok, symlink célpontok NEM versionáltók)
data/raw/BTCUSD/*.csv
data/raw/XAUUSD/*.csv
data/exam/BTCUSD/*.csv
data/exam/XAUUSD/*.csv
data/labeled/
data/processed/
data/synthetic_btcusd.csv
data/features_*
data/labels_*
data/pipeline_result_*

# Optuna adatbázis
*.db

# venv — sosem megy fel
venv/
.venv/
env/

# Nagy log fájlok (36MB+)
*.log

# DEB csomagok
*.deb

# GraphRAG output (generált gráf adatok)
graphrag_data/output/
graphrag_data/cache/
graphrag_data/lancedb/

# IDE user-specifikus (nem verziózott)
.idea/

# OS
.DS_Store
Thumbs.db

# Temp
*.tmp
*.bak
.gh_token
