    "meta_labeling_filter": {
      "description": "Signal refinement via meta-labeling (take/skip + sizing)",
      "priority": "HIGHEST — critical for signal quality",
      "source": "meta-labeling-harness + meta-labeling-alpha-filter",
      "features": {
        "p_take": {
          "logic": "P(take) from meta-model — take/skip decision",
          "when": "Primary meta-labeling signal"
        },
        "p_margin": {
          "logic": "max(0, P(take) - max(P(skip), P(fade)))",
          "when": "Margin sizing mode"
        },
        "meta_threshold": {
          "logic": "Side-specific threshold (long=0.45, short=0.50)",
          "when": "Asymmetric filtering"
        },
        "meta_gap": {
          "logic": "P(take) - max(P(competing)) >= 0.10",
          "when": "Overtrading guard"
        },
        "weight_mode": {
          "logic": "prob|margin|odds → position size",
          "when": "Sizing by confidence"
        },
        "vol_target": {
          "logic": "EWMA(63) vol → scale to target 20%",
          "when": "Risk management"
        },
        "leverage_cap": {
          "logic": "Hard cap at 3x gross leverage",
          "when": "Risk management"
        }
      }
    }
