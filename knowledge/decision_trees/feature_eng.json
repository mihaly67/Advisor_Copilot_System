  "feature_selection": {
    "methods": {
      "correlation_pruning": {
        "logic": "Remove features with corr > 0.95 (keep higher AUC)",
        "when": "ALWAYS — reduce redundancy"
      },
      "shap_importance": {
        "logic": "SHAP values → drop low-importance features",
        "when": "After initial training",
        "reference": "/data/ml/shap-master/"
      },
      "mutual_information": {
        "logic": "MI between feature and label",
        "when": "Non-linear relationship detection"
      },
      "frac_diff": {
        "logic": "Fractional differencing: find min d where series is stationary but max memory preserved",
        "when": "Price series → fractionally differenced features",
        "reference": "digest_frac_diff.md"
      }
    },
    "anti_patterns": [
      {
        "wrong": "RSI/ADX/Stochastic as direction feature",
        "right": "DF_Curve, Flow_Delta, PV_Corr, Mom_Persistence",
        "why": "RSI/ADX/Stoch AUC≈0.53 — barely better than random for direction"
      },
      {
        "wrong": "All float features for LightGBM",
        "right": "Mix boolean + float — trees split better on boolean",
        "why": "AlphaPy: boolean features let trees find context combinations"
      },
      {
        "wrong": "Raw price as feature",
        "right": "Returns, log-returns, or fractionally differenced prices",
        "why": "Raw price non-stationary → model learns price level, not dynamics"
      }
    ]
  },
  "leakage_prevention": {
    "rules": [
      "Every feature must use .shift(1) or rolling that ends at t-1",
      "Never use close[t] in feature for prediction at t",
      "Verify: corr(feature, label) < 0.95 (if > 0.95, likely leakage)",
      "Label uses future data (barriers) — features must NOT",
      "Feature at time t must only use data up to time t-1"
    ]
  }
}